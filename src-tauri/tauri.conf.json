{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quran",
  "version": "1.0.0-107",
  "identifier": "com.learnqurankids.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "حاج أيوب أمين",
        "width": 450,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 حاج أيوب أمين. All rights reserved.",
    "category": "Education",
    "shortDescription": "تطبيق تعليم القرآن الكريم برواية ورش بصوت القارئ الشيخ حاج أيوب أمين للأطفال والكبار",
    "longDescription": "تطبيق قرآني تفاعلي تعليمي يتيح تلاوة القرآن الكريم برواية ورش عن نافع بصوت الشيخ حاج أيوب أمين مع إمكانية العمل دون اتصال بالإنترنت وحفظ التقدم وركن آمن للأطفال.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

