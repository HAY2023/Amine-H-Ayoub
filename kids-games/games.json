{
  "games": [
    {
      "id": "demo-star-catch",
      "title": "اصطد النجمة (لعبة السيرفر)",
      "desc": "لعبة نموذجية تُحمَّل من هذا الملف دون تحديث التطبيق — كل نقرة تمنح نجمة واحدة",
      "icon": "Gamepad2",
      "ageMin": 5,
      "cost": 15,
      "kind": "html",
      "html": "<!DOCTYPE html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui,sans-serif;background:linear-gradient(160deg,#0f172a,#1e293b);min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;user-select:none;-webkit-user-select:none;touch-action:manipulation}h1{font-size:1.3rem;margin-bottom:.5rem}p{color:#94a3b8;font-size:.85rem;margin-bottom:1rem}#score{font-size:1.6rem;font-weight:800;color:#fbbf24;margin-bottom:1rem}#star{font-size:3.4rem;cursor:pointer;transition:transform .12s;filter:drop-shadow(0 0 12px rgba(251,191,36,.7))}#star:active{transform:scale(.8)}button{margin-top:1.6rem;padding:.7rem 1.6rem;border:0;border-radius:999px;background:#f59e0b;color:#1c1917;font-weight:800;font-size:.95rem;cursor:pointer}</style></head><body><h1>🌟 اصطد النجمة</h1><p>اضغط على النجمة كلما ظهرت في مكان جديد</p><div id=\"score\">⭐ 0</div><div id=\"star\">⭐</div><button id=\"exit\">💾 حفظ والخروج</button><script>(function(){var s=0,el=document.getElementById(\"star\"),sc=document.getElementById(\"score\");function move(){el.style.position=\"fixed\";el.style.left=(15+Math.random()*70)+\"%\";el.style.top=(15+Math.random()*65)+\"%\"}el.addEventListener(\"click\",function(){s++;sc.textContent=\"⭐ \"+s;try{parent.postMessage({type:\"nour:game:stars\",amount:1},\"*\")}catch(e){}move()});document.getElementById(\"exit\").addEventListener(\"click\",function(){try{parent.postMessage({type:\"nour:game:exit\"},\"*\")}catch(e){}});try{parent.postMessage({type:\"nour:game:ready\"},\"*\")}catch(e){}window.addEventListener(\"message\",function(ev){var d=ev.data||{};if(d.type===\"nour:game:profile\"){document.querySelector(\"h1\").textContent=\"مرحباً \"+(d.name||\"بطل\")+\" 🌟\"}});move()})();</script></body></html>"
    },
    {
      "id": "falling-stars",
      "title": "النجوم الهابطة",
      "desc": "اصطد النجوم وهي تسقط من الأعلى قبل أن تختفي — والألماس يعطي ٣ نجوم!",
      "icon": "Sparkles",
      "ageMin": 5,
      "cost": 20,
      "kind": "html",
      "html": "<!DOCTYPE html><html lang='ar' dir='rtl'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1'><style>*{margin:0;box-sizing:border-box}body{font-family:system-ui;background:linear-gradient(180deg,#0f172a,#1e3a8a);min-height:100vh;overflow:hidden;user-select:none;-webkit-user-select:none}#hud{position:fixed;top:10px;right:14px;color:#fbbf24;font-weight:800;font-size:1.2rem;z-index:5}#exit{position:fixed;top:8px;left:12px;z-index:5;padding:7px 16px;border:0;border-radius:999px;background:#f59e0b;color:#111;font-weight:800;cursor:pointer}.s{position:fixed;font-size:2.4rem;cursor:pointer;z-index:2;filter:drop-shadow(0 0 8px rgba(251,191,36,.8))}</style></head><body><div id='hud'>⭐ 0</div><button id='exit'>💾 خروج</button><script>var s=0,h=document.getElementById('hud');function drop(){var e=document.createElement('div');e.className='s';e.textContent=Math.random()<.15?'💎':'⭐';var v=Math.random()<.15?3:1;e.style.left=(8+Math.random()*80)+'vw';e.style.top='-50px';document.body.appendChild(e);var y=-50;var iv=setInterval(function(){y+=3+Math.random()*2;e.style.top=y+'px';if(y>innerHeight+40){clearInterval(iv);e.remove()}},28);e.addEventListener('click',function(){clearInterval(iv);e.remove();s+=v;h.textContent='⭐ '+s;try{parent.postMessage({type:'nour:game:stars',amount:v},'*')}catch(x){}})}var loop=setInterval(drop,1100);document.getElementById('exit').addEventListener('click',function(){clearInterval(loop);try{parent.postMessage({type:'nour:game:exit'},'*')}catch(x){}});try{parent.postMessage({type:'nour:game:ready'},'*')}catch(x){}</script></body></html>"
    },
    {
      "id": "memory-emojis",
      "title": "لعبة الذاكرة",
      "desc": "اقلب البطاقات وطابق الأزواج المتشابهة — كل زوج يمنحك نجومين",
      "icon": "LayoutGrid",
      "ageMin": 5,
      "cost": 25,
      "kind": "html",
      "html": "<!DOCTYPE html><html lang='ar' dir='rtl'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1'><style>*{margin:0;box-sizing:border-box}body{font-family:system-ui;background:linear-gradient(160deg,#1e1b4b,#4c1d95);min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;user-select:none;-webkit-user-select:none}h1{font-size:1.2rem;margin-bottom:.8rem}#g{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;width:min(92vw,420px)}.c{aspect-ratio:1;background:#312e81;border:2px solid #6366f1;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:2rem;cursor:pointer;transition:opacity .3s}#hud{margin-top:1rem;color:#fbbf24;font-weight:800;font-size:1.1rem}#exit{margin-top:.8rem;padding:8px 18px;border:0;border-radius:999px;background:#f59e0b;color:#111;font-weight:800;cursor:pointer}</style></head><body><h1>🧠 لعبة الذاكرة</h1><div id='g'></div><div id='hud'>⭐ 0</div><button id='exit'>💾 خروج</button><script>var E=['🌙','⭐','📖','🕌'],cards=[],open=[],lock=false,s=0,found=0,g=document.getElementById('g');E.concat(E).sort(function(){return Math.random()-.5}).forEach(function(e){var d=document.createElement('div');d.className='c';d.dataset.e=e;g.appendChild(d);cards.push(d)});cards.forEach(function(d){d.addEventListener('click',function(){if(lock||d.dataset.done||open.indexOf(d)>-1)return;d.textContent=d.dataset.e;open.push(d);if(open.length===2){lock=true;setTimeout(function(){if(open[0].dataset.e===open[1].dataset.e){open.forEach(function(o){o.dataset.done=1;o.style.opacity=.35});s+=2;found++;document.getElementById('hud').textContent='⭐ '+s;try{parent.postMessage({type:'nour:game:stars',amount:2},'*')}catch(x){}if(found===E.length){setTimeout(function(){cards.forEach(function(c){c.dataset.done='';c.style.opacity=1;c.textContent=''});found=0},900)}}else{open.forEach(function(o){o.textContent=''})}open=[];lock=false},700)}})});document.getElementById('exit').addEventListener('click',function(){try{parent.postMessage({type:'nour:game:exit'},'*')}catch(x){}});try{parent.postMessage({type:'nour:game:ready'},'*')}catch(x){}</script></body></html>"
    },
    {
      "id": "odd-color",
      "title": "الشكل المختلف",
      "desc": "ابحث عن الدائرة ذات اللون المختلف — تزداد الصعوبة مع كل إجابة!",
      "icon": "Grid3x3",
      "ageMin": 6,
      "cost": 30,
      "kind": "html",
      "html": "<!DOCTYPE html><html lang='ar' dir='rtl'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1'><style>*{margin:0;box-sizing:border-box}body{font-family:system-ui;background:linear-gradient(160deg,#052e16,#065f46);min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;user-select:none;-webkit-user-select:none}h1{font-size:1.2rem;margin-bottom:.9rem}#g{display:grid;gap:10px;width:min(88vw,380px)}#g .o{aspect-ratio:1;border:0;border-radius:16px;cursor:pointer;transition:transform .1s}#g .o:active{transform:scale(.92)}#hud{margin-top:1.1rem;color:#fbbf24;font-weight:800;font-size:1.1rem}#exit{margin-top:.8rem;padding:8px 18px;border:0;border-radius:999px;background:#f59e0b;color:#111;font-weight:800;cursor:pointer}</style></head><body><h1>🎯 الشكل المختلف</h1><div id='g'></div><div id='hud'>⭐ 0</div><button id='exit'>💾 خروج</button><script>var s=0,lv=1,g=document.getElementById('g');function round(){g.innerHTML='';var n=lv<3?3:(lv<6?4:5),odd=Math.floor(Math.random()*n*n),l=52,dl=Math.max(6,14-lv);g.style.gridTemplateColumns='repeat('+n+',1fr)';for(var i=0;i<n*n;i++){var b=document.createElement('button');b.className='o';var isOdd=i===odd;b.style.background='hsl(210 60% '+(isOdd?l+dl:l)+'%)';(function(isO){b.addEventListener('click',function(){if(isO){s++;lv++;document.getElementById('hud').textContent='⭐ '+s;try{parent.postMessage({type:'nour:game:stars',amount:1},'*')}catch(x){}round()}else{b.style.opacity=.3;setTimeout(function(){b.style.opacity=1},250)}})})(isOdd);g.appendChild(b)}}round();document.getElementById('exit').addEventListener('click',function(){try{parent.postMessage({type:'nour:game:exit'},'*')}catch(x){}});try{parent.postMessage({type:'nour:game:ready'},'*')}catch(x){}</script></body></html>"
    },
    {
      "id": "count-stars",
      "title": "عدّ النجوم",
      "desc": "كم نجمة ترى؟ اختر الرقم الصحيح — كل إجابة صحيحة نجمة",
      "icon": "Hash",
      "ageMin": 5,
      "cost": 35,
      "kind": "html",
      "html": "<!DOCTYPE html><html lang='ar' dir='rtl'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1'><style>*{margin:0;box-sizing:border-box}body{font-family:system-ui;background:linear-gradient(160deg,#1e293b,#0f766e);min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;user-select:none;-webkit-user-select:none}h1{font-size:1.2rem;margin-bottom:1rem}#q{font-size:2.6rem;line-height:1.5;width:min(90vw,420px);min-height:120px;text-align:center;background:rgba(255,255,255,.08);border-radius:18px;padding:14px;margin-bottom:1.2rem}#ops{display:flex;gap:10px}#ops button{width:74px;height:58px;border:0;border-radius:14px;background:#f59e0b;color:#111;font-size:1.4rem;font-weight:800;cursor:pointer}#ops button:active{transform:scale(.94)}#hud{margin-top:1.2rem;color:#fbbf24;font-weight:800}#exit{margin-top:.8rem;padding:8px 18px;border:0;border-radius:999px;background:#0f766e;color:#fff;font-weight:800;cursor:pointer}</style></head><body><h1>🔢 عدّ النجوم</h1><div id='q'></div><div id='ops'></div><div id='hud'>⭐ 0</div><button id='exit'>💾 خروج</button><script>var s=0;function round(){var n=3+Math.floor(Math.random()*7),q=document.getElementById('q');q.textContent='';for(var i=0;i<n;i++){q.appendChild(document.createTextNode('⭐'));if(i%4===3)q.appendChild(document.createElement('br'))}var ops=document.getElementById('ops');ops.innerHTML='';var set=[n];while(set.length<3){var r=1+Math.floor(Math.random()*10);if(set.indexOf(r)<0)set.push(r)}set.sort(function(){return Math.random()-.5});set.forEach(function(v){var b=document.createElement('button');b.textContent=v;b.addEventListener('click',function(){if(v===n){s++;document.getElementById('hud').textContent='⭐ '+s;try{parent.postMessage({type:'nour:game:stars',amount:1},'*')}catch(x){}}round()});ops.appendChild(b)})}round();document.getElementById('exit').addEventListener('click',function(){try{parent.postMessage({type:'nour:game:exit'},'*')}catch(x){}});try{parent.postMessage({type:'nour:game:ready'},'*')}catch(x){}</script></body></html>"
    }
  ]
